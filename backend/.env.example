# Copy to backend/.env and fill in. backend/.env is git-ignored. Never commit real keys.
# Every setting is optional; the defaults are shown.

# ── LLM narrative (Groq) ──
# Only turns computed measurements into readable text; it never sees the photo.
# Without a key the API returns a deterministic template and reports "ai_source": "template".
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_TIMEOUT_SECONDS=20

# ── Server ──
# HOST=127.0.0.1
# PORT=5001
# LOG_LEVEL=INFO

# ── API hardening ──
# Comma-separated origins allowed to call /api/* from a browser. The page served by the
# backend itself (http://localhost:5001/) is same-origin and needs no entry.
# SHADESENSE_CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
# SHADESENSE_MAX_UPLOAD_MB=10
# SHADESENSE_MAX_IMAGE_PIXELS=40000000
# SHADESENSE_MAX_BATCH_IMAGES=5
# SHADESENSE_RATE_LIMIT_ANALYZE=10 per minute;200 per day
# SHADESENSE_RATE_LIMIT_BATCH=2 per minute
# Use Redis (e.g. redis://localhost:6379) when running several server processes
# SHADESENSE_RATE_LIMIT_STORAGE=memory://

# ── Colour pipeline ──
# Gray-world white balance. Keep OFF: on face close-ups it flips light/deep (see face_color.py).
# SHADESENSE_APPLY_WHITE_BALANCE=0
# FACE_LANDMARKER_MODEL=backend/face_landmarker.task

# MiniCPM-V key for the archived vision-model experiment (archive/ai/gemini/analyzer.py).
# Not used by the app.
MINICPM_API_KEY=your_minicpm_api_key_here
